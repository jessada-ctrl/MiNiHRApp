# ============================================================
# Backend (apps/backend/.env)
# ============================================================

# Non-standard DB port — see docker-compose.yml comment (5432/5433 get
# intercepted by something on some machines and always fail auth).
DATABASE_URL="postgresql://lala:lala_local_dev@127.0.0.1:48321/lala?schema=public"
JWT_SECRET="change-me-in-production"
PORT=3001

# --- Required in production (the container refuses to start without them) ---
# See docker-entrypoint.sh. Each one fails silently rather than loudly when
# missing, which is why they're checked at boot instead of first use.

# AES-256 key for at-rest encryption of tenant LINE credentials and leave
# attachment references (NFR-2). Without it the app falls back to a key that
# is a literal in the repo — fine locally, worthless once real customers
# exist. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_CRED_ENCRYPTION_KEY=

# Where leave-request attachments (medical certificates, FR-2.2) are written.
# MUST be a mounted volume in production — anything inside the container image
# is destroyed on the next deploy, taking every uploaded certificate with it.
# Defaults to ./var/attachments locally.
ATTACHMENTS_DIR=

# Email delivery: the FR-2.1 account-binding OTP and the "forgot password"
# link. With SMTP_HOST unset both are logged to the console instead of sent,
# which is fine for local development and useless in production — between
# them these are the only two routes back into an account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Lala' <no-reply@example.com>"

# --- Backups (see the runbook in README.md) ---

# Nightly logical backup of the database and the attachments volume. This is
# in addition to any snapshots the hosting provider takes: those live with
# the provider, are restorable only through it, and cover no attachments.
BACKUP_ENABLED=true
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Where archives go. With BACKUP_S3_BUCKET set they are uploaded to
# S3-compatible storage (MinIO, R2, S3, Spaces); without it they are written
# to BACKUP_DIR on this machine — which does NOT survive losing the machine,
# so treat local-only as a stopgap.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=lala-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Set to "false" only for real AWS S3, which uses virtual-host-style buckets.
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_DIR=

# --- Operator alerts ---
# Where the platform complains about itself: failed backups, backups that
# have stopped running at all. Nothing here goes to a customer.

# Comma-separated. Uses the SMTP settings above.
ALERT_EMAIL_TO=

# The LaLa' *platform* LINE OA — never a tenant's channel, whose members are
# that customer's employees. ALERT_LINE_TARGET_ID is the group/room/user id
# to push to.
ALERT_LINE_CHANNEL_ACCESS_TOKEN=
ALERT_LINE_TARGET_ID=

# --- Optional ---

# "json" for one structured line per event; defaults to json when
# NODE_ENV=production and to Nest's readable format otherwise.
LOG_FORMAT=

# LINE HR chatbot (Claude API) — required for ChatbotService to answer
# employee questions from the LINE webhook.
ANTHROPIC_API_KEY="REPLACE_WITH_ANTHROPIC_API_KEY"

# Comma-separated list of allowed browser origins for the API. Leave unset in
# the standard single-origin deploy (the backend serves both front-ends on the
# tenant's own domain, so requests are same-origin); set it only when a
# front-end is hosted somewhere else. Unset locally allows any localhost port.
CORS_ORIGINS=

# Local development escape hatch: returns the OTP in the HTTP response so a
# real device can complete the binding flow with no SMTP configured. Ignored
# entirely when NODE_ENV=production.
EXPOSE_OTP_FOR_TESTING=false

# Where the "forgot password" email's link points. Leave unset in production:
# the backend builds it from the request's own Host, so the link always lands
# on the tenant's own domain. Only needed locally, where the API answers on
# :3001 but web-admin runs on :3000 with no /admin basePath.
#   PASSWORD_RESET_URL_BASE="http://localhost:3000/reset-password"
PASSWORD_RESET_URL_BASE=


# ============================================================
# Web Admin (apps/web-admin/.env.local)
# ============================================================
# Both of these are LOCAL DEVELOPMENT ONLY and must stay unset in the built
# image. NEXT_PUBLIC_* values are inlined by `next build`, so setting them for
# a real deploy pins one image to one customer. Unset, the app derives the API
# base from its own origin and the tenant from the subdomain it was loaded on.

NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_TENANT_SUBDOMAIN="testco"


# ============================================================
# LIFF App (apps/liff-app/.env.local)
# ============================================================
# Same rule as above — local development only. In a real deploy the LIFF ID
# comes from GET /tenant/public-config (set per tenant on the /settings page),
# because each customer runs their own LINE Login channel.

NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_TENANT_SUBDOMAIN="testco"
NEXT_PUBLIC_LIFF_ID="REPLACE_WITH_LINE_LIFF_ID"
