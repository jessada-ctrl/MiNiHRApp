// Lala' database schema — mirrors the ERD in Doc/MiniHR_SRS-V1.md §6.
// Every tenant-scoped model carries tenantId and MUST be filtered by it on every query.
// See src/tenant/ for the interceptor that enforces this at the application layer (NFR-1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== Platform-level (not tenant-scoped) =====================

enum SubscriptionStatus {
  trial
  active
  suspended
}

// Who is allowed to ask the LINE chatbot "who is on leave today" — set by the
// tenant_admin on the /settings page. HR can always ask regardless of this
// value; it only widens the audience beyond HR.
enum ChatbotLeaveVisibility {
  hr_only
  hr_and_approver
  everyone
}

model Tenant {
  id                       String             @id @default(uuid())
  companyName              String             @map("company_name")
  subdomain                String             @unique
  lineChannelId             String?            @map("line_channel_id")
  lineChannelSecretEnc      String?            @map("line_channel_secret_enc")
  lineChannelAccessTokenEnc String?            @map("line_channel_access_token_enc")
  lineLiffId                String?            @map("line_liff_id")
  lineRichMenuUnregisteredId String?           @map("line_rich_menu_unregistered_id")
  lineRichMenuRegisteredId   String?           @map("line_rich_menu_registered_id")
  subscriptionStatus       SubscriptionStatus @default(trial) @map("subscription_status")
  chatbotWhoIsOnLeaveVisibility ChatbotLeaveVisibility @default(hr_only) @map("chatbot_who_is_on_leave_visibility")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  branches              Branch[]
  departments           Department[]
  employees             Employee[]
  leaveTypes            LeaveType[]
  leaveQuotas           LeaveQuota[]
  leaveRequests         LeaveRequest[]
  approvalWorkflows     ApprovalWorkflow[]
  approvalWorkflowSteps ApprovalWorkflowStep[]
  leaveApprovalActions  LeaveApprovalAction[]
  attendanceQrCodes     AttendanceQrCode[]
  attendanceLogs        AttendanceLog[]
  holidays              Holiday[]
  notificationLogs      NotificationLog[]
  auditLogs             AuditLog[]
  otpVerifications      OtpVerification[]
  leaveAttachments      LeaveAttachment[]
  passwordResetTokens   PasswordResetToken[]

  @@map("tenants")
}

model SaasAdmin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("saas_admins")
}

// ===================== Organization structure =====================

model Branch {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchName    String  @map("branch_name")
  address       String?
  latitude      Decimal @db.Decimal(9, 6)
  longitude     Decimal @db.Decimal(9, 6)
  radiusMeters  Int     @map("radius_meters")
  isActive      Boolean @default(true) @map("is_active")

  departments       Department[]
  employees         Employee[]
  attendanceQrCodes AttendanceQrCode[]
  attendanceLogs    AttendanceLog[]

  @@index([tenantId])
  @@map("branches")
}

model Department {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId       String? @map("branch_id")
  branch         Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentName String  @map("department_name")
  isActive       Boolean @default(true) @map("is_active")

  employees Employee[]

  @@index([tenantId])
  @@map("departments")
}

enum EmployeeRole {
  employee
  approver
  tenant_admin
}

enum EmployeeStatus {
  active
  inactive
}

model Employee {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeCode     String         @map("employee_code")
  fullName         String         @map("full_name")
  email            String
  phone            String?
  departmentId     String?        @map("department_id")
  department       Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branchId         String?        @map("branch_id")
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  position         String?
  hireDate         DateTime?      @map("hire_date") @db.Date
  lineUserId       String?        @unique @map("line_user_id")
  role             EmployeeRole   @default(employee)
  directManagerId  String?        @map("direct_manager_id")
  directManager    Employee?      @relation("EmployeeManager", fields: [directManagerId], references: [id], onDelete: SetNull)
  reports          Employee[]     @relation("EmployeeManager")
  passwordHash     String?        @map("password_hash")
  /// Every session issued before this moment is rejected by JwtStrategy.
  /// JWTs are stateless with an 8h life, so without this a password reset
  /// would leave whoever knew the old password logged in for the rest of the
  /// day — which is the exact situation a reset is meant to end. Null for
  /// accounts whose password has never been changed, so existing sessions
  /// aren't invalidated wholesale the first time this ships.
  passwordChangedAt DateTime?     @map("password_changed_at")
  /// Set whenever HR hands out a password the employee didn't choose (new
  /// account, or an admin-initiated reset). The employee is sent to a change
  /// -password screen until they pick their own, so a temp password relayed
  /// over chat or read aloud doesn't quietly become permanent.
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  status           EmployeeStatus @default(active)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  leaveQuotas             LeaveQuota[]
  leaveRequests           LeaveRequest[]
  currentApproverForLeave LeaveRequest[] @relation("LeaveRequestCurrentApprover")
  leaveApprovalActions    LeaveApprovalAction[]
  attendanceLogs          AttendanceLog[]
  otpVerifications        OtpVerification[]
  workflowStepAssignee    ApprovalWorkflowStep[]
  leaveAttachments        LeaveAttachment[]
  passwordResetTokens     PasswordResetToken[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@map("employees")
}

model OtpVerification {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId   String?   @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeCode String    @map("employee_code")
  email        String
  otpCodeHash  String    @map("otp_code_hash")
  attempts     Int       @default(0)
  expiresAt    DateTime  @map("expires_at")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("otp_verifications")
}

/// A single-use "forgot password" link.
///
/// Only the SHA-256 of the token is stored: the plaintext exists solely in
/// the email, so a database read alone can't be turned into account access.
/// (SHA-256 rather than bcrypt because the token is 32 random bytes — there
/// is no dictionary to slow an attacker down through, and bcrypt would only
/// add latency to every verification.)
model PasswordResetToken {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Stamped on use, rather than deleting the row, so a link that gets
  /// clicked twice can be told apart from one that never existed.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tokenHash])
  @@index([tenantId, employeeId])
  @@map("password_reset_tokens")
}

// ===================== Leave management =====================

model LeaveType {
  id                       String  @id @default(uuid())
  tenantId                 String  @map("tenant_id")
  tenant                   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                     String
  defaultQuota             Decimal @default(0) @map("default_quota") @db.Decimal(5, 2)
  requiresAttachmentAfterDays Int?  @map("requires_attachment_after_days")
  allowHourly              Boolean @default(true) @map("allow_hourly")
  isPaid                   Boolean @default(true) @map("is_paid")

  leaveQuotas   LeaveQuota[]
  leaveRequests LeaveRequest[]

  @@index([tenantId])
  @@map("leave_types")
}

model LeaveQuota {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String    @map("leave_type_id")
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  totalDays   Decimal   @map("total_days") @db.Decimal(5, 2)

  @@unique([employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@map("leave_quotas")
}

enum LeaveDurationType {
  full_day
  half_am
  half_pm
  hourly
}

enum LeaveRequestStatus {
  pending
  approved
  rejected
  cancelled
}

model LeaveRequest {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId       String              @map("employee_id")
  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId      String              @map("leave_type_id")
  leaveType        LeaveType           @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  durationType     LeaveDurationType   @map("duration_type")
  startDatetime    DateTime            @map("start_datetime")
  endDatetime      DateTime            @map("end_datetime")
  totalDays        Decimal             @map("total_days") @db.Decimal(5, 2)
  reason           String?
  attachmentUrlEnc String?             @map("attachment_url_enc")
  isOverQuota      Boolean             @default(false) @map("is_over_quota")
  lwopAcknowledged Boolean             @default(false) @map("lwop_acknowledged")
  status           LeaveRequestStatus  @default(pending)
  currentStep      Int                 @default(0) @map("current_step")
  workflowSnapshot Json                @map("workflow_snapshot")
  // Denormalized from workflowSnapshot[currentStep] and kept in sync on
  // every step advance — lets the approver queue query be a plain indexed
  // WHERE instead of filtering JSON in application code for every request.
  currentApproverId String?  @map("current_approver_id")
  currentApprover    Employee? @relation("LeaveRequestCurrentApprover", fields: [currentApproverId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  approvalActions LeaveApprovalAction[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, currentApproverId, status])
  @@map("leave_requests")
}

/// FR-2.2's medical certificate. Uploaded before the leave request exists (the
/// request can't be submitted without it), so this stands on its own rather
/// than hanging off LeaveRequest — `leave_requests.attachment_url_enc` holds
/// the encrypted id of the row that ends up being used, and rows never claimed
/// by a request are pruned by the scheduler.
///
/// Only metadata lives here. The bytes are written to object storage under
/// `storageKey` (see AttachmentStorageService), because medical certificates
/// are the single most sensitive payload in the system and inlining them in
/// the DB would put them in every backup and every query plan.
model LeaveAttachment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  uploadedByEmployeeId String   @map("uploaded_by_employee_id")
  uploadedBy           Employee @relation(fields: [uploadedByEmployeeId], references: [id], onDelete: Cascade)

  /// Tenant-prefixed path within the storage root. Not encrypted: it is
  /// derived from ids already in this row, so encrypting it would protect
  /// nothing the row doesn't already reveal.
  storageKey       String   @map("storage_key")
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, uploadedByEmployeeId])
  @@map("leave_attachments")
}

// ===================== Approval workflow =====================

enum WorkflowScopeType {
  department
  branch
  leave_type
  global
}

model ApprovalWorkflow {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  scopeType WorkflowScopeType @default(global) @map("scope_type")
  scopeId   String?           @map("scope_id")

  steps ApprovalWorkflowStep[]

  @@index([tenantId])
  @@map("approval_workflows")
}

enum ApproverType {
  specific_employee
  direct_manager
  role
}

model ApprovalWorkflowStep {
  id       String @id @default(uuid())
  // Denormalized from the parent workflow so this table can be filtered by
  // tenant_id directly (NFR-1) instead of relying on a join through workflow_id.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  workflowId String            @map("workflow_id")
  workflow   ApprovalWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  stepOrder           Int          @map("step_order")
  approverType         ApproverType @map("approver_type")
  approverEmployeeId   String?      @map("approver_employee_id")
  approverEmployee     Employee?    @relation(fields: [approverEmployeeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([workflowId])
  @@map("approval_workflow_steps")
}

enum ApprovalActionType {
  approve
  reject
}

model LeaveApprovalAction {
  id       String @id @default(uuid())
  // Denormalized from the parent request, same rationale as ApprovalWorkflowStep.tenantId above.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  requestId String       @map("request_id")
  request   LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stepOrder  Int                 @map("step_order")
  approverId String              @map("approver_id")
  approver   Employee            @relation(fields: [approverId], references: [id], onDelete: Restrict)
  action     ApprovalActionType
  comment    String?
  actedAt    DateTime            @default(now()) @map("acted_at")

  @@index([tenantId])
  @@index([requestId])
  @@map("leave_approval_actions")
}

// ===================== Attendance =====================

model AttendanceQrCode {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrToken   String   @unique @map("qr_token")
  validDate DateTime @map("valid_date") @db.Date

  @@index([tenantId])
  @@map("attendance_qr_codes")
}

enum AttendanceCheckType {
  in
  out
}

enum AttendanceMethod {
  qr
  gps
}

model AttendanceLog {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId         String               @map("employee_id")
  employee           Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branchId           String?              @map("branch_id")
  branch             Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  checkType          AttendanceCheckType  @map("check_type")
  timestamp          DateTime             @default(now())
  latitudeEnc        String?              @map("latitude_enc")
  longitudeEnc       String?              @map("longitude_enc")
  method             AttendanceMethod
  isFlaggedSpoofing  Boolean              @default(false) @map("is_flagged_spoofing")

  @@index([tenantId])
  @@index([tenantId, employeeId, timestamp])
  @@map("attendance_logs")
}

// ===================== Holidays & notifications =====================

model Holiday {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  holidayDate      DateTime @map("holiday_date") @db.Date
  name             String
  notifyDaysBefore Int      @map("notify_days_before")

  @@index([tenantId])
  @@map("holidays")
}

model NotificationLog {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  recipientLineUserId String  @map("recipient_line_user_id")
  messageType         String  @map("message_type")
  relatedRequestId    String? @map("related_request_id")
  sentAt              DateTime @default(now()) @map("sent_at")
  status              String

  @@index([tenantId])
  @@map("notification_logs")
}

// ===================== Audit (immutable — see NFR-4) =====================

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  userId     String   @map("user_id")
  action     String
  targetTable String  @map("target_table")
  targetId   String?  @map("target_id")
  ipAddress  String   @map("ip_address")
  timestamp  DateTime @default(now())

  @@index([tenantId])
  @@map("audit_logs")
}
